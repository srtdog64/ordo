{
  "name": "@exornea/ordo-runtime",
  "version": "0.12.0",
  "type": "module",
  "description": "Host-agnostic runtime layer for @exornea/ordo frame ticking, events, actions, and clock control.",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "clean": "node -e \"const fs=require('fs'); fs.rmSync('dist',{recursive:true,force:true}); fs.rmSync('tsconfig.tsbuildinfo',{force:true});\"",
    "build": "npm run clean && tsc -b",
    "check": "tsc -b --pretty false",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "@exornea/ordo": "^0.12.0"
  },
  "devDependencies": {
    "@exornea/ordo": "file:../..",
    "typescript": "^5.9.3"
  }
}
